---
import type { MenuItem } from "../data/menu";
import Kip from "./Kip.astro";

interface Props {
    item: MenuItem;
}

const { item } = Astro.props;
---

<article class="group relative h-full pt-12">
    <!-- A child's chicken peeks out from behind the card -->
    <Kip
        name={item.peek}
        class="absolute right-8 top-0 z-0 w-24 translate-y-14 rotate-6 transition-transform duration-500 ease-[cubic-bezier(0.34,1.56,0.64,1)] group-hover:translate-y-0 group-hover:rotate-0"
    />

    <div class="relative z-10 flex h-full flex-col overflow-hidden rounded-[2rem] bg-card shadow-paper transition-all duration-500 ease-[cubic-bezier(0.22,1,0.36,1)] group-hover:-translate-y-2 group-hover:shadow-lift">
        <div aria-hidden="true" class="gingham-strip h-3"></div>

        <!-- Image and price -->
        <div class="relative p-3 pb-0">
            <div class="overflow-hidden rounded-[1.4rem]">
                <img
                    src={item.image}
                    alt={item.imageAlt}
                    loading="lazy"
                    width="900"
                    height="700"
                    class="aspect-[4/3] w-full object-cover transition-transform duration-700 ease-out group-hover:scale-105"
                />
            </div>

            <span class="plate absolute -bottom-8 right-6 grid size-24 place-items-center p-4 text-center font-display text-lg font-extrabold uppercase leading-[0.95] text-primary">
                {item.price}
            </span>
        </div>

        <!-- Card content -->
        <div class="flex flex-1 flex-col p-6 pt-4">
            {item.tag && (
                <p class="font-hand text-xl text-primary">{item.tag}</p>
            )}

            <h3 class="font-display text-4xl font-extrabold uppercase leading-none text-ink">
                {item.name}
            </h3>

            <p class="mt-3 leading-relaxed text-muted-foreground">
                {item.description}
            </p>
        </div>
    </div>
</article>
