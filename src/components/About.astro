---
import { Trees, Bus, HeartHandshake } from "lucide-astro";
import { Image } from "astro:assets";

import communityImage from "../assets/community-dinner.webp";
import { EVENT_INFO } from "../lib/site-config";

import Reveal from "./Reveal.astro";
import SectionHeading from "./SectionHeading.astro";
import Kip from "./Kip.astro";

const GOALS = [
    {
        icon: Trees,
        title: "Bos- en zeeklassen",
        text: "Samen op stap, ver weg van de schoolbanken.",
    },
    {
        icon: Bus,
        title: "Leerrijke uitstappen",
        text: "Musea, workshops en ontdekkingen buiten de klas.",
    },
    {
        icon: HeartHandshake,
        title: "Samen als school",
        text: "Ouders, grootouders, leerkrachten en buren aan één tafel.",
    },
];
---

<section
    id="over"
    aria-labelledby="over-title"
    class="relative overflow-hidden py-24 md:py-32"
>
    <div class="mx-auto grid max-w-7xl items-center gap-20 px-5 md:px-8 lg:grid-cols-2">
        <!-- Content -->
        <div>
            <Reveal>
                <SectionHeading
                    id="over-title"
                    eyebrow="Over het evenement"
                    title="Lekker eten, samen iets betekenen"
                />

                <div class="mt-6 space-y-4 text-lg leading-relaxed text-muted-foreground">
                    <p>
                        VIBO Kiplekker is het jaarlijkse eetfestijn van Vibo
                        OV1. Op{" "}
                        <strong class="font-semibold text-ink">
                            {EVENT_INFO.datum.toLowerCase()}
                        </strong>{" "}
                        genieten we samen van een heerlijke kip aan het spit.
                    </p>

                    <p>
                        <strong class="font-semibold text-ink">
                            Elke bestelling steunt onze leerlingen.
                        </strong>{" "}
                        De opbrengst gaat naar onze bosklassen, zodat elk kind
                        kan genieten van onvergetelijke ervaringen buiten de
                        klas.
                    </p>
                </div>
            </Reveal>

            <!-- Goals -->
            <ul class="mt-10 space-y-3">
                {GOALS.map((goal, i) => {
                    const Icon = goal.icon;

                    return (
                        <li>
                            <Reveal delay={i * 110}>
                                <div class="flex items-center gap-4 rounded-2xl bg-card p-4 shadow-paper transition-transform duration-300 hover:translate-x-1">
                                    <span class="grid size-12 shrink-0 place-items-center rounded-full bg-primary text-primary-foreground">
                                        <Icon class="size-6" />
                                    </span>

                                    <div>
                                        <h3 class="font-display text-2xl font-bold uppercase leading-none text-ink">
                                            {goal.title}
                                        </h3>

                                        <p class="mt-1 text-muted-foreground">
                                            {goal.text}
                                        </p>
                                    </div>
                                </div>
                            </Reveal>
                        </li>
                    );
                })}
            </ul>
        </div>

        <!-- Image and illustrations -->
        <Reveal class="relative mx-auto w-full max-w-lg">
            <Kip
                name="kleur"
                hop
                class="absolute -top-28 right-2 z-10 w-32 md:-top-32 md:w-40"
            />

            <div class="gingham -rotate-2 rounded-[2rem] p-3 shadow-lift [--gingham-size:22px] md:p-4">
                <Image
                    src={communityImage}
                    alt="Gezinnen, grootouders en kinderen die samen genieten van een kipmaaltijd in de schoolzaal"
                    class="aspect-[5/4.6] w-full rounded-[1.4rem] object-cover"
                    loading="lazy"
                    width={1100}
                    height={1005}
                    fit="cover"
                    format="webp"
                />
            </div>

            <div class="napkin absolute -bottom-10 left-4 max-w-[15rem] rotate-[-4deg] rounded-2xl px-5 py-4 md:-left-10">
                <p class="font-hand text-xl leading-snug text-ink">
                    Alle kippen op deze site werden getekend door{" "}
                    <span class="text-primary">onze leerlingen</span>!
                </p>
            </div>

            <Kip
                name="bol"
                class="absolute -bottom-14 -right-4 w-28 md:-right-12 md:w-36"
            />
        </Reveal>
    </div>
</section>
