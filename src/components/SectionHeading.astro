---
interface Props {
    eyebrow: string;
    title?: string;
    intro?: string;
    align?: "left" | "center";
    inverted?: boolean;
    class?: string;
    id?: string;
}

const {
    eyebrow,
    title,
    intro,
    align = "left",
    inverted = false,
    class: className = "",
    id,
} = Astro.props;

const hasTitleSlot = Astro.slots.has("title");
const hasIntroSlot = Astro.slots.has("intro");
---

<div
    class:list={[
        "max-w-2xl",
        align === "center" && "mx-auto text-center",
        className,
    ]}
>
    <p
        class:list={[
            "font-hand text-2xl md:text-[1.7rem]",
            inverted ? "text-plate/80" : "text-primary",
        ]}
    >
        {eyebrow}
    </p>

    <h2
        id={id}
        class:list={[
            "mt-1 font-display text-5xl font-extrabold uppercase leading-[0.9] md:text-7xl",
            inverted ? "text-plate" : "text-ink",
        ]}
    >
        {hasTitleSlot ? <slot name="title" /> : title}
    </h2>

    {(intro || hasIntroSlot) && (
        <p
            class:list={[
                "mt-5 text-lg leading-relaxed",
                inverted ? "text-plate/80" : "text-muted-foreground",
            ]}
        >
            {hasIntroSlot ? <slot name="intro" /> : intro}
        </p>
    )}
</div>
